5. Decorators with multiple argumenst and key value pairs

def multi2(fun_obj):
    def myinner(*arg):
        return fun_obj(*arg).upper()
    return myinner
        
@multi2
def fun(*x):
    return "Welcome "+x[0]+x[1]

print(fun("anil","sunil","ajay"))
