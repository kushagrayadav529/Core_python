3. Nested Dictionary storing multiple values

mystu={"stud1":
    {"name":"tarum",
    "phone":987655,
    "skill":"python"},
       
    "stud2":{
     "name":"kush",
    "phone":987675,
    "skill":"java"},
       
    "stud3":{
    "name":"vedansh",
    "phone":987645,
    "skill":"flask"}
}
 
for k,v_obj in mystu.items():
    print(k)
    for st_key in v_obj:                         # it will return each key from v_obj
        print(st_key +':',v_obj[st_key])
